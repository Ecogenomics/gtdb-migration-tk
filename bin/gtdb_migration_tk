"""Executable wrapper for the GTDB Migration Toolkit.

All argument parsing and dispatch lives in gtdb_migration_tk/__main__.py. This
script exists only so the toolkit can be invoked as `gtdb_migration_tk`, and is
equivalent to `python -m gtdb_migration_tk`. Arguments are read from sys.argv by
main(), so everything provided on the command line is passed through unchanged.
"""

import os
import sys

# support running directly from a source checkout, without installing
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))

from gtdb_migration_tk.__main__ import main

if __name__ == '__main__':
    main()
